# CORS Configuration
CORS_ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# API Configuration
API_KEY=your_secure_api_key_here  # Change this to a secure random string in production

# File Upload Configuration
MAX_UPLOAD_BYTES=10485760  # 10 MB
ALLOWED_MIME_TYPES='["image/jpeg", "image/png", "image/jpg"]'  # Allowed MIME types for uploads

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=app.log  # Set to "" or "none" to disable file logging
LOG_FORMAT=json  # json or text

# Request Configuration
REQUEST_TIMEOUT=30  # Request timeout in seconds

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true  # Enable/disable rate limiting globally
GLOBAL_RATE_LIMIT=100  # Requests per minute per IP
API_KEY_RATE_LIMIT=1000  # Requests per minute per API key
RATE_LIMIT_BYPASS_KEYS='[]'  # List of API keys that bypass rate limiting

# Document Type Validation
ALLOWED_DOCUMENT_TYPES='["KTP", "SIM", "STNK", "KIR"]'  # Allowed document types

# Security Settings
REQUIRE_API_KEY=true  # Set to false to disable API key requirement (not recommended for production)
